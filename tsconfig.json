{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@babel/core": ["node_modules/@babel/core"],
      "@babel/traverse": ["node_modules/@babel/traverse"]
    }
  },
  "exclude": ["node_modules"]
}